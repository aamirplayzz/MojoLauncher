<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- thick bottom edge gives the raised 3D look -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A1488" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- button face -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#6A2BD9"
                android:endColor="#A15CFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#D2A8FF" />
        </shape>
    </item>
    <!-- glossy highlight -->
    <item android:bottom="22dp" android:left="4dp" android:right="4dp" android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00FFFFFF"
                android:endColor="#55FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
