<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#6A2BD9" android:endColor="#A15CFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#D2A8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3140A33" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#7B3FE0" />
        </shape>
    </item>
</selector>
